            "timeout": 15
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/inbox-read.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "\"C:/Users/araji/AppData/Local/Programs/Python/Python311/python.exe\" \"$CLAUDE_PROJECT_DIR/.claude/hooks/state_tracker_enqueue.py\"",
            "timeout": 15
          }
